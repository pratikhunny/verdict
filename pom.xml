<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Verdict — single Spring Boot service. The domain core (party, contract, examination, ledger,
      entitlement, recon, journal, casework, orchestrator) carries NO Spring imports and compiles and
      runs as plain Java; Spring lives only in the com.sc.verdict.app package. This is enforced by
      package discipline and the ArchitectureRules scanner, not just intent.

      Spring Boot pinned to the latest stable 3.5.x (CLAUDE.md: Java 21 · Spring Boot 3.x), verified
      against Maven Central rather than recalled.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.sc</groupId>
    <artifactId>verdict</artifactId>
    <version>0.1.0</version>
    <name>Verdict</name>
    <description>Conditional hold, examine, split and release — the disagreement, automated.</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Spring AI 1.1.x is the Spring Boot 3.5 line; 2.0.x targets Boot 4. Verified on Maven Central. -->
        <spring-ai.version>1.1.8</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Spring AI gives us a provider-agnostic ChatModel. To adopt a different backend model "as per
          availability", swap this one starter (spring-ai-starter-model-openai / -ollama / -bedrock /
          -vertex-ai-gemini) and set the matching properties — the LlmExtractionAdapter code does not
          change, because it depends on the ChatModel abstraction, not the vendor.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-anthropic</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
